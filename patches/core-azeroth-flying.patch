+    {
+        if (!sConfigMgr->GetOption<bool>("AzerothFlying.Enable", false) || IsNoFlyArea(player))
+            return false;
+    }
+    else if (map != MAP_OUTLAND && (map != MAP_NORTHREND || !player->HasSpell(ColdWeatherFlying)))
         return false;
 
     AreaTableEntry const* area = sAreaTableStore.LookupEntry(player->GetAreaId());
