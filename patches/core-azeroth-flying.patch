 namespace
 {
 constexpr uint32 ColdWeatherFlying = 54197;
@@ -74,10 +78,55 @@ public:
 
 namespace AscensionMountSpeed
 {
-bool CanFly(Player*, SpellInfo const*)
+bool IsNoFlyArea(Player* player)
 {
+    std::string const list = sConfigMgr->GetOption<std::string>("AzerothFlying.NoFlyAreas", "");
+    if (list.empty())
+        return false;
+
+    uint32 const area = player->GetAreaId();
+    uint32 const zone = player->GetZoneId();
+    char const* at = list.c_str();
+    while (*at)
+    {
+        char* end = nullptr;
+        unsigned long const id = std::strtoul(at, &end, 10);
+        if (end == at)
+            break;
+        if (id == area || id == zone)
+            return true;
+        at = end;
+        while (*at == ',' || *at == ' ' || *at == ';')
+            ++at;
+    }
     return false;
 }
+
+bool PlayerFlightAllowed(Player* player)
+{
+    if (!player || !sConfigMgr->GetOption<bool>("AzerothFlying.Enable", false) || player->InBattleground())
+        return false;
+
+    // The current CoA core disables player flight everywhere. This module only turns it back on in
+    // Eastern Kingdoms and Kalimdor when AzerothFlying.Enable is on. Outland and Northrend stay
+    // exactly as the core has them.
+    uint32 const map = GetVirtualMapForMapAndZone(player->GetMapId(), player->GetZoneId());
+    return (map == MAP_EASTERN_KINGDOMS || map == MAP_KALIMDOR) && !IsNoFlyArea(player);
+}
+
+bool CanFly(Player* player, SpellInfo const* mount)
+{
+    if (!mount || player->GetBaseSkillValue(SKILL_RIDING) < RIDING_SKILL_EXPERT || !PlayerFlightAllowed(player))
+        return false;
+
+    AreaTableEntry const* area = sAreaTableStore.LookupEntry(player->GetAreaId());
+    Battlefield* battlefield = sBattlefieldMgr->GetBattlefieldToZoneId(player->GetZoneId());
+    if ((area && (area->flags & AREA_FLAG_NO_FLY_ZONE)) || (battlefield && !battlefield->CanFlyIn()))
+        return false;
+
+    return mount->CheckLocation(player->GetMapId(), player->GetZoneId(), player->GetAreaId(), player) ==
+        SPELL_CAST_OK && player->canFlyInZone(player->GetMapId(), player->GetZoneId(), mount);
+}
 }
 
 void AddSC_AscensionMountSpeed()
